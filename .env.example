# ── App ──────────────────────────────────────────────────────────────────────
# Öffentliche URL der Website (wichtig für Links, Stripe-Redirects, Facebook)
NEXT_PUBLIC_SERVER_URL=https://vh.dominikdill.com
# Geheimer Schlüssel für Payload (z.B. mit `openssl rand -hex 32` erzeugen)
PAYLOAD_SECRET=change-me

# ── Datenbank (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URI=postgres://vh:change-me@db:5432/vh
POSTGRES_USER=vh
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vh

# ═══════════════════════════════════════════════════════════════════════════
# Ab hier ALLES OPTIONAL: E-Mail, Stripe und Facebook lassen sich bequemer im
# Admin-Backend pflegen (Verwaltung → Integrationen). Die env-Werte dienen
# nur als Fallback, wenn die Felder dort leer sind.
# ═══════════════════════════════════════════════════════════════════════════

# ── E-Mail (SMTP) ────────────────────────────────────────────────────────────
# Ohne SMTP-Server werden Mails nur in die Konsole geloggt (Entwicklung)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=info@vincent-hellmann.com
EMAIL_FROM_NAME=Vincent Hellmann
# Empfänger für Kontakt-/Bestellbenachrichtigungen
NOTIFICATION_EMAIL=info@vincent-hellmann.com

# ── Stripe (Zahlungen) ───────────────────────────────────────────────────────
# Testmodus-Keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Signing-Secret des Webhook-Endpunkts https://vh.dominikdill.com/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# ── PayPal (2. Zahlart, optional) ────────────────────────────────────────────
# Empfohlen: direkt im Admin unter Integrationen → PayPal pflegen
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=false

# ── Facebook (News-Autopost, optional) ───────────────────────────────────────
# Meta-App mit pages_manage_posts + langlebiger Page Access Token
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# ── MCP-Server (Verwaltung per KI-Assistent, optional) ───────────────────────
# Geheimer Schlüssel für den MCP-Endpunkt /api/mcp/mcp (z.B. openssl rand -hex 24).
# Leer lassen = MCP deaktiviert.
MCP_API_KEY=

# ── Docker/Traefik ───────────────────────────────────────────────────────────
DOMAIN=vh.dominikdill.com
# Traefik-Entrypoint (TLS terminiert der Nginx Proxy Manager davor)
TRAEFIK_ENTRYPOINT=web
