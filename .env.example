# ── Fassung ──────────────────────────────────────────────────────────────────
# Welches Abbild der Stack zieht. Leer oder nicht gesetzt heißt `latest` — also
# der Stand von `main`, der sich nach jedem Push von selbst ausrollt. Wer einen
# bestimmten Stand fahren will (etwa zum Ausprobieren, bevor er auf main geht),
# trägt hier dessen Nummer ein: VH_FASSUNG=1.1.0
VH_FASSUNG=latest

# ── App ──────────────────────────────────────────────────────────────────────
# Öffentliche URL der Website (wichtig für Links, Stripe-Redirects, Facebook)
NEXT_PUBLIC_SERVER_URL=https://vh.dominikdill.com
# Geheimer Schlüssel für Payload (z.B. mit `openssl rand -hex 32` erzeugen)
PAYLOAD_SECRET=change-me

# ── Datenbank (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URI=postgres://vh:change-me@db:5432/vh
POSTGRES_USER=vh
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vh

# ═══════════════════════════════════════════════════════════════════════════
# Ab hier ALLES OPTIONAL: E-Mail, Stripe und Facebook lassen sich bequemer im
# Admin-Backend pflegen (Verwaltung → Integrationen). Die env-Werte dienen
# nur als Fallback, wenn die Felder dort leer sind.
# ═══════════════════════════════════════════════════════════════════════════

# ── E-Mail (SMTP) ────────────────────────────────────────────────────────────
# Ohne SMTP-Server werden Mails nur in die Konsole geloggt (Entwicklung)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=info@vincent-hellmann.com
EMAIL_FROM_NAME=Vincent Hellmann
# Empfänger für Kontakt-/Bestellbenachrichtigungen
NOTIFICATION_EMAIL=info@vincent-hellmann.com

# ── Stripe (Zahlungen) ───────────────────────────────────────────────────────
# Testmodus-Keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Signing-Secret des Webhook-Endpunkts https://vh.dominikdill.com/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# ── PayPal (2. Zahlart, optional) ────────────────────────────────────────────
# Empfohlen: direkt im Admin unter Integrationen → PayPal pflegen
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=false

# ── Facebook (News-Autopost, optional) ───────────────────────────────────────
# Meta-App mit pages_manage_posts + langlebiger Page Access Token
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# Instagram-Konto der Seite (für den Autopost nach Instagram)
IG_ACCOUNT_ID=

# ── MCP-Server (Verwaltung per KI-Assistent, optional) ───────────────────────
# Endpunkt: /api/mcp
# Bequemer ist die Pflege im Admin unter Verwaltung → Integrationen → KI-Assistent;
# dort lassen sich die Schlüssel erzeugen und die fertige Verbindungs-URL kopieren.
# Diese Variablen sind nur der Rückfall, falls im Admin nichts hinterlegt ist.
# Ohne jeden Schlüssel ist der Endpunkt abgeschaltet (503).
#
# Voller Zugriff — wirkt wie ein Admin-Passwort (z.B. openssl rand -hex 24):
MCP_API_KEY=
# Nur lesen — Inhalte, Bestellungen und Auswertungen einsehen, keine Änderungen:
MCP_READONLY_API_KEY=

# ── Büro (/office) ───────────────────────────────────────────────────────────
# Postfächer und der Claude-Schlüssel werden im Admin unter „Integrationen"
# gepflegt — hier steht nur, was ohne Oberfläche gebraucht wird.
#
# Schlüssel für den Cron-Job, der neue Post meldet:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://…/api/office/post/pruefen
CRON_SECRET=


# Herkunft der cookiefreien Besucherstatistik für die Sicherheitsrichtlinie
# (CSP). Wird im Admin ein Statistik-Skript hinterlegt, muss dessen Herkunft
# hier stehen — sonst blockt der Browser es stillschweigend.
#   CSP_EXTRA_SCRIPT=https://plausible.io
CSP_EXTRA_SCRIPT=

# Startpasswörter für die Büro-Zugänge (leer = es wird gewürfelt und einmal angezeigt).
# Im Container BENUTZER=true setzen, dann werden die Konten beim Start angelegt:
BENUTZER=false
VH_PASSWORT=
ADMIN_PASSWORT=

# ── Docker/Traefik ───────────────────────────────────────────────────────────
DOMAIN=vh.dominikdill.com
# Traefik-Entrypoint (TLS terminiert der Nginx Proxy Manager davor)
TRAEFIK_ENTRYPOINT=web

# ── Einmalige Startläufe ─────────────────────────────────────────────────────
# Beim allerersten Start auf "true": spielt die Startinhalte ein
SEED=false
# Einmalig auf "true": schreibt die englischen Übersetzungen der
# Seed-Inhalte in die Datenbank — danach wieder auf "false"
TRANSLATE_EN=false
