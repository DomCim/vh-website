{
  "name": "Vincent Hellmann Büro",
  "short_name": "VH Büro",
  "description": "Belege, Rechnungen, Inventar und Steuer-Export",
  "id": "/office",
  "start_url": "/office",
  "scope": "/office",
  "display": "standalone",
  "background_color": "#f7f6f4",
  "theme_color": "#f7f6f4",
  "lang": "de",
  "icons": [
    { "src": "/office-icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/office-icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "/office-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "launch_handler": { "client_mode": "navigate-existing" },
  "shortcuts": [
    {
      "name": "Aufträge",
      "url": "/office/auftraege",
      "icons": [{ "src": "/office-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Laufmarken",
      "url": "/office/laufmarken",
      "icons": [{ "src": "/office-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Beleg erfassen",
      "url": "/office/belege/neu",
      "icons": [{ "src": "/office-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Rechnung schreiben",
      "url": "/office/rechnungen/neu",
      "icons": [{ "src": "/office-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
